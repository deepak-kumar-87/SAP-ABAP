REPORT ZBT_CDS_SO.

PARAMETERS p_so TYPE vbeln_va.

select * from zsocds( p_vbeln = @p_so ) INTO TABLE @data(lt_cds).


  CALL METHOD CL_DEMO_OUTPUT=>DISPLAY
    EXPORTING
      DATA   = lt_cds
